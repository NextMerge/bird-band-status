{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortTailwindcss": {
    "functions": ["cn"]
  },
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".pnp",
    ".pnp.js",
    "tsconfig.json",
    "tsconfig.*.json",
    ".oxlintrc.json",
    ".oxlintrc.*.json",
    ".gitignore",
    "routeTree.gen.ts"
  ]
}
